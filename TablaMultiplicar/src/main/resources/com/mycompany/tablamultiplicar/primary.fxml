<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tablamultiplicar.PrimaryController">
   <children>
      <Label text="Primary View" />
      <TextField fx:id="txtNumero" />
      <Button fx:id="btnCalcular" text="Calcular" onAction="#btnCalcular"/>
      <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar"/>
      <TextArea fx:id="txtResultado"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
