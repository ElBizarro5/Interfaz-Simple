<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.divisores.PrimaryController">
   <children>
      <Label text="Ingrese un numero" />
      <TextField fx:id="txtCantidad" prefHeight="25.0" prefWidth="209.0" />
      <Button fx:id="Analizar_btn" text="Analizar" onAction="#btnAnalizar"/>
      <Button fx:id="Limpiar_btn" text="Limpiar" onAction="#btnLimpiar"/>
      <Label text="Cantidad de cifras" />
      <TextArea fx:id="txtCifras" prefHeight="31.0" prefWidth="466.0" />
      <Label text="Suma de cifras impares" />
      <TextArea fx:id="txtImpares" prefHeight="11.0" prefWidth="459.0" />
      <Label text="Suma de cifras pares" />
      <TextArea fx:id="txtPares" prefHeight="12.0" prefWidth="408.0" />
      <Label text="Suma total de cifras" />
      <TextArea fx:id="txtTotal" prefHeight="25.0" prefWidth="459.0" />
      <Label text="Cifra mayor" />
      <TextArea fx:id="txtMayor" prefHeight="2.0" prefWidth="447.0" />
      <Label text="Cifra menor" />
      <TextArea fx:id="txtMenor" prefHeight="0.0" prefWidth="457.0" />
      <Label text="Divisores" />
      <TextArea fx:id="txtDivisores" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
